%%machine oct;
%%write  data;

static int   cs  = 0;           ///< current state
static int   act = 0;           ///< ???
static char* eof = nullptr;     ///< end of file marker
static char* ts  = nullptr;     ///< token start
static char* te  = nullptr;     ///< token end

static  bool positive = true;   ///< sign flag
static   int integer  = 0;      ///< integer part
static  bool point    = false;  ///< was point flag
static   int fraction = 0;      ///< fraction part
static   int frac     = 0;      ///< fraction divider $10^frac$

#include <math.h>

float num(char* p, char* pe) {
    integer = fraction = frac = 0; positive = true; point = false;
    eof = pe; cs = act = 0; ts = te = nullptr;
    %%write init;
    %%write exec;
    static float number = integer + fraction / pow(10.0, frac);
    if (positive) return +number; else return -number;
}

%%{
    num := |*
        '+'   => { positive =  true; };
        '-'   => { positive = false; };
        '.'   => {    point =  true; };
        [0-9] => {
            if   (!point) { integer  = integer  * 10 + (ts[0] - '0');         }
            else          { fraction = fraction * 10 + (ts[0] - '0'); frac++; }
        };
    *|;
}%%
