%%machine oct;
%%write  data;

static int   cs  = 0;           ///< current state
static int   act = 0;           ///< ???
static char* eof = nullptr;     ///< end of file marker
static char* ts  = nullptr;     ///< token start
static char* te  = nullptr;     ///< token end

static  int   number = 0;       ///< result number
static bool positive = true;    ///< sign flag

int oct(char* p, char* pe) {
    number = 0; positive = true;
    eof = pe; cs = act = 0; ts = te = nullptr;
    %%write init;
    %%write exec;
    if (positive) return +number; else return -number;
}

%%{
    oct := |*
        'o'   => {                                         };
        '+'   => { positive =  true;                       };
        '-'   => { positive = false;                       };
        [0-7] => { number = (number << 3) | (ts[0] - '0'); };
    *|;
}%%
