{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cortexM",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            // "preLaunchTask": "debug: openocd",
            // "preLaunchTask": "CMake: build",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerArgs": "--silent",
            "miDebuggerServerAddress": "localhost:12345",
            "useExtendedRemote": true,
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ],
            // "debugServerPath": "openocd",
            // "debugServerArgs": "-f ${workspaceFolder}/hw/${command:cmake.activeConfigurePresetName}/${command:cmake.activeConfigurePresetName}.openocd -c \"program ${command:cmake.launchTargetPath} verify reset\"",
            // "serverStarted": "connections",
            // "stopAtEntry": true,
            "postRemoteConnectCommands": [
                {"text": "monitor reset halt"},
                {"text": "load"},
                {"text": "set substitute-path /home/pere/src/newlib-salsa ${userHome}/em/ref/newlib-salsa"},
                // {"text": "b Reset_Handler"},
                // {"text": "b SystemInit"},
                // {"text": "b startup_bp"},
                // {"text": "b __libc_init_array"},
                {"text": "b main"},
                // {"text": "b MX_GPIO_Init"},
                {"text": "b sbrk"}, {"text": "b _sbrk"},
                {"text": "monitor reset halt"}, // req
            ],
        },
        {
            "name": "linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "preLaunchTask": "CMake: build",
            "args": ["${workspaceFolder}/lib/${workspaceFolderBasename}.ini"],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "stopAtEntry": true,
            "MIMode": "gdb",
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ]
        }
    ]
}
