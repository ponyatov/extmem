@@ -40,6 +21,10 @@
 .word	_sdata
 /* end address for the .data section. defined in linker script */
 .word	_edata
+/* CCMRAM addresses */
+.word	_siccm
+.word	_sccm
+.word	_eccm
 /* start address for the .bss section. defined in linker script */
 .word	_sbss
 /* end address for the .bss section. defined in linker script */
@@ -80,7 +65,24 @@
   adds r4, r0, r3
   cmp r4, r1
   bcc CopyDataInit
-  
+
+/* Copy the ccm segment initializers from flash to CCMRAM */
+  ldr r0, =_sccm
+  ldr r1, =_eccm
+  ldr r2, =_siccm
+  movs r3, #0
+  b LoopCopyCCMInit
+
+CopyCCMInit:
+  ldr r4, [r2, r3]
+  str r4, [r0, r3]
+  adds r3, r3, #4
+
+LoopCopyCCMInit:
+  adds r4, r0, r3
+  cmp r4, r1
+  bcc CopyCCMInit
+
 /* Zero fill the bss segment. */
   ldr r2, =_sbss
   ldr r4, =_ebss
@@ -544,4 +546,3 @@
 	
 	.weak	DMA2D_IRQHandler
 	.thumb_set FPU_IRQHandler,Default_Handler    
