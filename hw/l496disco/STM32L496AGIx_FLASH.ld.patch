 /* Entry Point */
 ENTRY(Reset_Handler)
 
 /* Highest address of the user mode stack */
-_estack = ORIGIN() + LENGTH();    /* end of RAM */
+_estack = ORIGIN(CCMRAM) + LENGTH(CCMRAM);   /* end of CCMRAM */
 /* Generate a link error if heap and stack don't fit into RAM */
-_Min_Heap_Size = 0x200;      /* required amount of heap  */
-_Min_Stack_Size = 0x400; /* required amount of stack */
+_Min_Heap_Size  = 0x200;          /* required amount of heap  */
+_Min_Stack_Size = 0x400;          /* required amount of stack */
 
 /* Specify the memory areas */
 MEMORY
 {
-RAM (xrw)      : ORIGIN = 0x20000000, LENGTH = 256K
-RAM2 (xrw)      : ORIGIN = 0x10000000, LENGTH = 64K
-FLASH (rx)      : ORIGIN = 0x8000000, LENGTH = 1024K
+FLASH  (r x) : ORIGIN = 0x8000000 , LENGTH = 1024K
+RAM    (rwx) : ORIGIN = 0x20000000, LENGTH = 320K
+SRAM1  (rwx) : ORIGIN = 0x20000000, LENGTH = 256K
+SRAM2  (rwx) : ORIGIN = 0x20040000, LENGTH = 64K        /* CCM mapped??? */
+CCMRAM (rwx) : ORIGIN = 0x10000000, LENGTH = 64K
+FMC1   (rwx) : ORIGIN = 0x60000000, LENGTH = 0K         /* bank 1  */
+XRAM   (rwx) : ORIGIN = 0xD0000000, LENGTH = 0x00200000 /* fmc.h   ??? */
+FMC3   (rwx) : ORIGIN = 0x80000000, LENGTH = 0K         /* bank 3  */
+QSPI   (rwx) : ORIGIN = 0x90000000, LENGTH = 0K         /* QUADSPI */
+FMCrg  (rw ) : ORIGIN = 0xA0000000, LENGTH = 0x1000     /* FMC registers  */
+QSPIrg (rw ) : ORIGIN = 0xA0001000, LENGTH = 0x1400     /* QSPI registers */
 }
 
 /* Define output sections */
@@ -103,8 +67,8 @@
     . = ALIGN(8);
   } >FLASH
 
-  .ARM.extab   : 
-  { 
+  .ARM.extab   :
+  {
   . = ALIGN(8);
   *(.ARM.extab* .gnu.linkonce.armextab.*)
   . = ALIGN(8);
@@ -125,7 +89,7 @@
     PROVIDE_HIDDEN (__preinit_array_end = .);
 	. = ALIGN(8);
   } >FLASH
-  
+
   .init_array :
   {
 	. = ALIGN(8);
@@ -135,6 +99,7 @@
     PROVIDE_HIDDEN (__init_array_end = .);
 	. = ALIGN(8);
   } >FLASH
+
   .fini_array :
   {
 	. = ALIGN(8);
@@ -145,23 +110,49 @@
 	. = ALIGN(8);
   } >FLASH
 
+  /* hold FMC configuration in static segment, memcpy from startup_ */
+  _sifmcrg = LOADADDR(.fmcrg);
+  .fmcrg : {
+    . = ALIGN(8);
+    _sfmcrg = .;
+    *(.fmcrg)
+    *(.fmcrg*)
+    KEEP (*(.fmcrg*))
+    . = ALIGN(8);
+    _efmcrg = .;
+  } >FMCrg AT>FLASH
+
   /* used by the startup to initialize data */
   _sidata = LOADADDR(.data);
 
   /* Initialized data sections goes into RAM, load LMA copy after code */
-  .data : 
+  .data :
   {
     . = ALIGN(8);
     _sdata = .;        /* create a global symbol at data start */
-    *(.data)           /* .data sections */
+    *(.data)           /* .data  sections */
     *(.data*)          /* .data* sections */
 
     . = ALIGN(8);
     _edata = .;        /* define a global symbol at data end */
-  } > AT> FLASH
+  } >RAM AT>FLASH
+
+  /* used by the startup to initialize CCMRAM */
+  _siccm = LOADADDR(.ccm);
+
+  /* Initialized data goes into CCMRAM, load LMA copy after code */
+  .ccm :
+  {
+    . = ALIGN(8);
+    _sccm = .;        /* create a global symbol at ccm start */
+    *(.ccm)           /* .ccm  sections */
+    *(.ccm*)          /* .ccm* sections */
+
+    . = ALIGN(8);
+    _eccm = .;        /* define a global symbol at ccm end */
+  } >CCMRAM AT>FLASH
 
-  
-  /* Uninitialized data section */
+/* Uninitialized data section */
   . = ALIGN(4);
   .bss :
   {
@@ -175,7 +166,7 @@
     . = ALIGN(4);
     _ebss = .;         /* define a global symbol at bss end */
     __bss_end__ = _ebss;
-  } >
+  } >RAM
 
   /* User_heap_stack section, used to check that there is enough RAM left */
   ._user_heap_stack :
@@ -186,18 +177,29 @@
     . = . + _Min_Heap_Size;
     . = . + _Min_Stack_Size;
     . = ALIGN(8);
-  } >
+  } >RAM
 
-  
+  /* EXTRAM (bank1) section, code must be located here explicitly        */
+  /* Example: extern int foo(void) __attribute__ ((section (".xtext"))); */
+  _sixram = LOADADDR(.xram);
+  .xram :
+  {
+    . = ALIGN(8);
+    _sxram = .;
+    *(.xtext)
+    *(.xtext*)
+    . = ALIGN(8);
+    *(.xram)
+    *(.xram*)
+    . = ALIGN(8);
+    _exram = .;
+  } >XRAM AT>FLASH
 
